    "expo-store-review": "~57.0.1",
    "expo-tracking-transparency": "~57.0.1",
    "expo-widgets": "~57.0.6",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
