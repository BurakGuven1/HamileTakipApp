    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "^26.2.0",
    "@react-native-firebase/app": "^26.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
