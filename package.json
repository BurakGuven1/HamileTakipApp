{
  "name": "hamile-bebek-takip",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "lint": "expo lint",
    "vercel-build": "npm run web:export",
    "deploy:web": "npx vercel --prod --archive=tgz",
    "deploy:web:eas": "eas deploy",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "verify:revenuecat": "node tools/verify-revenuecat-config.mjs",
    "verify:meta": "node --env-file-if-exists=.env tools/verify-meta-config.mjs",
    "verify:firebase:ios": "node --env-file-if-exists=.env tools/verify-firebase-ios-config.mjs",
    "verify:firebase:ios:generated": "node tools/verify-generated-firebase-ios.mjs",
    "eas-build-post-install": "npm run verify:revenuecat && npm run verify:meta && npm run verify:firebase:ios"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@react-native-firebase/app",
          "@react-native-firebase/analytics"
        ]
      }
    }
  },
  "dependencies": {
    "@dariyd/react-native-text-recognition": "2.0.20",
