# App
APP_VARIANT=development
EXPO_OWNER=burakguven351999
EAS_PROJECT_ID=

# Bundle identifiers
EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=com.burakguven.hamiletakip
EXPO_PUBLIC_ANDROID_PACKAGE=com.burakguven.hamiletakip
# App Store Connect'teki uygulama sayfası yayınlandıktan sonra tam URL'yi ekle.
# Örnek: https://apps.apple.com/tr/app/anne/id1234567890
EXPO_PUBLIC_IOS_APP_STORE_URL=

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_KEY
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# Public base URL where the contents of public/ are deployed, without a trailing slash.
# Example: https://your-legal-site.example
EXPO_PUBLIC_LEGAL_BASE_URL=https://hamile-takip-app-vqgw.vercel.app

# Meta App Events (build-time only; META_CLIENT_TOKEN is embedded in Info.plist)
META_APP_ID=YOUR_META_APP_ID
META_CLIENT_TOKEN=YOUR_META_CLIENT_TOKEN

# Optional: emits a custom event only in a __DEV__ build for Events Manager testing.
EXPO_PUBLIC_META_TEST_EVENT_ENABLED=false
